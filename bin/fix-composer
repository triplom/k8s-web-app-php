#!/bin/bash

# Composer dependency fix script for k8s-web-app-php
# This script helps resolve common composer dependency issues

set -e

echo "🔧 PHP Composer Dependency Fix Script"
echo "======================================"

# Check PHP version
echo "📋 Current PHP version:"
php --version

# Check Composer version
echo "📋 Current Composer version:"
composer --version

echo ""
echo "🧹 Cleaning existing dependencies..."
rm -rf vendor/
rm -f composer.lock

echo ""
echo "🔄 Attempting to install dependencies with different strategies..."

# Strategy 1: Try standard install
echo "Strategy 1: Standard composer install..."
if composer install --ignore-platform-reqs --prefer-dist --optimize-autoloader; then
    echo "✅ Success with standard install"
    exit 0
fi

echo "❌ Strategy 1 failed, trying Strategy 2..."

# Strategy 2: Try with no scripts
echo "Strategy 2: Installing without scripts..."
if composer install --ignore-platform-reqs --no-scripts --prefer-dist --optimize-autoloader; then
    echo "✅ Success without scripts"
    exit 0
fi

echo "❌ Strategy 2 failed, trying Strategy 3..."

# Strategy 3: Update all dependencies
echo "Strategy 3: Updating all dependencies..."
if composer update --ignore-platform-reqs --prefer-dist --with-all-dependencies --optimize-autoloader; then
    echo "✅ Success with dependency update"
    exit 0
fi

echo "❌ Strategy 3 failed, trying Strategy 4..."

# Strategy 4: Remove lock file and update
echo "Strategy 4: Remove lock file and update..."
rm -f composer.lock
if composer update --ignore-platform-reqs --prefer-dist --with-all-dependencies --optimize-autoloader; then
    echo "✅ Success with fresh lock file"
    exit 0
fi

echo "❌ Strategy 4 failed, trying Strategy 5..."

# Strategy 5: Try with specific composer version
echo "Strategy 5: Checking if we can install older composer..."
if command -v composer1 >/dev/null 2>&1; then
    echo "Found composer1, trying with that..."
    if composer1 install --ignore-platform-reqs --prefer-dist --optimize-autoloader; then
        echo "✅ Success with composer1"
        exit 0
    fi
fi

echo "❌ All strategies failed. Manual intervention required."
echo ""
echo "🔍 Troubleshooting tips:"
echo "1. Consider updating composer.json to use more recent package versions"
echo "2. Check if you're using the correct PHP version (7.3-7.4 recommended for this project)"
echo "3. Some packages may need to be updated individually"
echo ""
echo "📦 Current problematic packages based on error logs:"
echo "- ocramius/package-versions: needs composer-plugin-api ^1.0.0"
echo "- symfony/flex: needs composer-plugin-api ^1.0"
echo "- symfony/thanks: needs composer-plugin-api ^1.0"
echo "- phpstan/extension-installer: needs composer-plugin-api ^1.1"
echo ""
echo "💡 Consider running: composer require ocramius/package-versions:^1.8 --update-with-dependencies"

exit 1